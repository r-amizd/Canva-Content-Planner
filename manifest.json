{
  "manifest_version": 3,
  "name": "Canva Multi-Platform Dispatcher",
  "version": "1.0.0",
  "description": "One-click batch duplication and campaign preparation for Canva",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.canva.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.canva.com/*"],
      "js": ["main_world_runner.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.canva.com/*"],
      "js": ["content_script.js"],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}